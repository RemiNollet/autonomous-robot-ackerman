<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carsim_bridge</name>
  <version>0.1.0</version>
  <description>
    ZeroMQ bridge between the macOS MuJoCo sim and the ROS2 graph, plus the
    dummy controller and the lane-perception node. The only packages in
    this graph that know the simulator or the perception model exist --
    everything downstream sees only /carsim/* topics and /lane_state
    (docs/decisions.md ADR-1, ADR-2; docs/lane-state-contract.md).
  </description>
  <maintainer email="remi.nollet@live.fr">Remi Nollet</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>carsim_msgs</depend>
  <exec_depend>python3-zmq</exec_depend>

  <!--
    perception_node.py also needs torch and pillow (CPU-only). Neither has
    a resolvable rosdep key, so they're deliberately not declared here:
    a package.xml depend rosdep can't resolve breaks rosdep's
    from-paths dependency installation step. They're pip-installed into
    the VM venv instead; see requirements_vm.txt (repo root) for versions
    and the system-site-packages rationale (rclpy from apt must stay
    importable alongside them).
  -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

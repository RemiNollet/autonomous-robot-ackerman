#!/bin/sh
# `ros2 run`'s normal path is a setuptools console_script, generated by
# colcon's ament_python build step -- but that script's shebang always
# ends up `/usr/bin/python3` (system Python), never the venv's, no matter
# what's active in the shell at build time. Root cause: `colcon` itself is
# apt-installed at /usr/bin/colcon with its own `#!/usr/bin/python3`
# shebang; sourcing the ackerman_ros2 venv never shadows it (colcon isn't
# ALSO installed inside the venv), so everything colcon's own process
# does -- including generating this package's other console_scripts --
# inherits COLCON's interpreter, not the venv's. This node needs packages
# that only exist in that venv (torch, pillow -- --system-site-packages,
# so rclpy from apt stays importable alongside them), so it can't go
# through that path at all.
#
# Installed verbatim via setup.py's data_files (not entry_points), so
# nothing ever rewrites this shebang -- sidesteps the problem instead of
# patching its symptom after every colcon build.
#
# CARSIM_BRIDGE_VENV overrides the venv location; defaults to this
# project's one established VM venv (~/venvs/ackerman_ros2, same
# convention docs/decisions.md's M3 OCP task and ADR-1 already assume
# for ACADOS_SOURCE_DIR and friends -- single-developer VM, not meant to
# generalize past that without also generalizing those).
VENV="${CARSIM_BRIDGE_VENV:-$HOME/venvs/ackerman_ros2}"
exec "$VENV/bin/python3" -m carsim_bridge.perception_node "$@"
